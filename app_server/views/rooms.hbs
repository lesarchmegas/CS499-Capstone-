<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css" type="text/css">
</head>

<body>

<div id="background">
<div id="page">

    {{> header }}

    <div id="contents">
        <div class="box">
            <div>
                <div class="body">

                    <h1>Rooms</h1>

                    <ul id="rooms">

                        <li>
                            <a href="#">
                                <img src="/images/first-class.jpg" alt="Img">
                            </a>
                            <h2>First Class Room</h2>
                            <p>Cras dui sapien, feugiat vitae tristique ut, lobortis tempor orci.</p>
                            <span class="rate">Rate: 220 / Day</span>
                        </li>

                        <li>
                            <a href="#">
                                <img src="/images/deluxe.jpg" alt="Img">
                            </a>
                            <h2>Deluxe Room</h2>
                            <p>Sed et augue lorem. In sit amet placerat arcu.</p>
                            <span class="rate">Rate: 150 / Day</span>
                        </li>

                        <li>
                            <a href="#">
                                <img src="/images/suite.jpg" alt="Img">
                            </a>
                            <h2>Suite Room</h2>
                            <p>Sed et augue lorem. In sit amet placerat arcu.</p>
                            <span class="rate">Rate: 180 / Day</span>
                        </li>

                    </ul>

                </div>
            </div>
        </div>
    </div>

    {{> footer }}

</div>
</div>

</body>
</html>